@model IEnumerable<emotion_meter.Models.MoodState>
@{
    var gulsah = Model.FirstOrDefault(m => m.UserName == "Gülşah");
    var yunus = Model.FirstOrDefault(m => m.UserName == "Yunus Emre");
}

<div class="planet planet-1"></div>
<div class="planet planet-2"></div>

<div class="app-container">
    
    <div class="glass-card">
        
        <div class="header-bar">
            <div class="logo-section">
                <span class="logo-icon">🐙</span>
                <h2 class="title-text" id="mainTitle">GÜLŞAH'IN DUYGU METRESİ</h2>
            </div>
            <button class="profile-btn">
                👤 Profile
            </button>
        </div>
        
        <button class="share-btn">
            🔗 Share
        </button>

        <!-- Ahtapot Görsel Alanı -->
        <div class="visual-area" id="visualArea">
            <div class="cevir-text">ÇEVİR 🔄</div>
            <img src="~/images/happy_octopus.png" alt="Happy Octopus" class="octopus-img octopus-happy" />
            <img src="~/images/angry_octopus.png" alt="Angry Octopus" class="octopus-img octopus-angry" />
        </div>

        <!-- Gülşah Kontrolleri -->
        <div class="controls-section" id="panel-gulsah">
            <div class="slider-group">
                <span class="slider-label">SİNİR</span>
                <div class="slider-wrapper">
                    <input type="range" class="sinir-range" id="gulsahSinirRange" value="@(gulsah?.Sinir ?? 0)" min="0" max="100" oninput="sendMoodUpdate('Gülşah')">
                </div>
                <span class="slider-value" id="gulsahSinirVal">%@(gulsah?.Sinir ?? 0)</span>
            </div>
            
            <div class="slider-group">
                <span class="slider-label">STRES</span>
                <div class="slider-wrapper">
                    <input type="range" class="stres-range" id="gulsahStresRange" value="@(gulsah?.Stres ?? 0)" min="0" max="100" oninput="sendMoodUpdate('Gülşah')">
                </div>
                <span class="slider-value" id="gulsahStresVal">%@(gulsah?.Stres ?? 0)</span>
            </div>
            
            <div class="slider-group">
                <span class="slider-label">MUTLULUK</span>
                <div class="slider-wrapper">
                    <input type="range" class="mutluluk-range" id="gulsahMutlulukRange" value="@(gulsah?.Mutluluk ?? 100)" min="0" max="100" oninput="sendMoodUpdate('Gülşah')">
                </div>
                <span class="slider-value" id="gulsahMutlulukVal">%@(gulsah?.Mutluluk ?? 100)</span>
            </div>
        </div>

        <!-- Yunus Emre Kontrolleri -->
        <div class="controls-section" id="panel-yunus" style="display:none;">
            <div class="slider-group">
                <span class="slider-label">SİNİR</span>
                <div class="slider-wrapper">
                    <input type="range" class="sinir-range" id="yunusSinirRange" value="@(yunus?.Sinir ?? 0)" min="0" max="100" oninput="sendMoodUpdate('Yunus Emre')">
                </div>
                <span class="slider-value" id="yunusSinirVal">%@(yunus?.Sinir ?? 0)</span>
            </div>
            
            <div class="slider-group">
                <span class="slider-label">STRES</span>
                <div class="slider-wrapper">
                    <input type="range" class="stres-range" id="yunusStresRange" value="@(yunus?.Stres ?? 0)" min="0" max="100" oninput="sendMoodUpdate('Yunus Emre')">
                </div>
                <span class="slider-value" id="yunusStresVal">%@(yunus?.Stres ?? 0)</span>
            </div>
            
            <div class="slider-group">
                <span class="slider-label">MUTLULUK</span>
                <div class="slider-wrapper">
                    <input type="range" class="mutluluk-range" id="yunusMutlulukRange" value="@(yunus?.Mutluluk ?? 100)" min="0" max="100" oninput="sendMoodUpdate('Yunus Emre')">
                </div>
                <span class="slider-value" id="yunusMutlulukVal">%@(yunus?.Mutluluk ?? 100)</span>
            </div>
        </div>

    </div>

    <!-- Kullanıcı Değiştirme Butonları -->
    <div class="user-switch">
        <button class="switch-btn active" id="btn-gulsah" onclick="switchUser('Gülşah')">Gülşah'ın Paneli</button>
        <button class="switch-btn" id="btn-yunus" onclick="switchUser('Yunus Emre')">Yunus Emre'nin Paneli</button>
    </div>

</div>

@section Scripts {
    <script src="~/js/mood.js"></script>
}
