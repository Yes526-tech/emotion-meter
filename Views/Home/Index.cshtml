@model IEnumerable<emotion_meter.Models.MoodState>
@{
    var gulsah = Model.FirstOrDefault(m => m.UserName == "Gülşah");
}

<div class="space-bg">
    <div class="stars"></div>
    <div class="meteor m1"></div>
    <div class="meteor m2"></div>
    <div class="ship xwing">🚀</div>
    <div class="ship tiefighter">🛸</div>
</div>

<div class="mobile-app-container">
    
    <!-- Üst Başlık Barı -->
    <div class="header-bar">
        <div class="logo-section">
            <span class="logo-icon">🐙</span>
            <div class="title-text-group">
                <span class="subtitle">GÜLŞAH CUSTOM</span>
                <h2 class="title-text">GÜLŞAH'IN DUYGU METRESİ</h2>
            </div>
        </div>
    </div>
    
    <!-- Ana Kart -->
    <div class="glass-card">


        <!-- Gauge Gösterge Alanı -->
        <div class="gauge-container" id="gaugeContainer">
            <div class="gauge-wrapper">
                <div class="gauge-bg"></div>
                <div class="gauge-center-hole"></div>
                <div class="gauge-needle" id="gaugeNeedle">
                    <div class="needle-base"></div>
                </div>
                <!-- Yüz İfadeleri (Emojiler) -->
                <div class="emoji-label e1">🤬</div>
                <div class="emoji-label e2">😠</div>
                <div class="emoji-label e3">😟</div>
                <div class="emoji-label e4">🙂</div>
                <div class="emoji-label e5">😄</div>
                <div class="emoji-label e6">🥰</div>
            </div>
            
            <h2 class="gauge-status-text" id="gaugeStatusText"></h2>

            <div class="ai-message-box" id="aiMessageBox" style="display: none;">
                <div class="ai-icon">💌</div>
                <div class="ai-text" id="aiMessageText">Emre yazıyor...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/mood.js"></script>
}
