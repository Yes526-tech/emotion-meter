@model IEnumerable<emotion_meter.Models.MoodState>
@{
    var gulsah = Model.FirstOrDefault(m => m.UserName == "Gülşah");
}

<div class="space-bg">
    <div class="stars"></div>
    <div class="meteor m1"></div>
    <div class="meteor m2"></div>
    <div class="ship xwing">🚀</div>
    <div class="ship tiefighter">🛸</div>
</div>

<div class="mobile-app-container">
    
    <!-- Üst Başlık Barı -->
    <div class="header-bar">
        <div class="logo-section">
            <span class="logo-icon">🐙</span>
            <div class="title-text-group">
                <span class="subtitle">GÜLŞAH CUSTOM</span>
                <h2 class="title-text">GÜLŞAH'IN DUYGU METRESİ</h2>
            </div>
        </div>
    </div>
    
    <!-- Ana Kart -->
    <div class="glass-card">


        <!-- Ahtapot Görsel Alanı -->
        <div class="visual-area" id="visualArea">
            <img src="~/images/jedi_octopus.png" id="main-octopus" class="octopus-img active-img" />
        </div>

        <!-- Kontroller -->
        <div class="controls-section">
            <div class="mood-grid">
                <!-- ROW 1 -->
                <button class="mood-btn btn-red" onclick="selectMood('furious', 0, 100)">Furious</button>
                <button class="mood-btn btn-red" onclick="selectMood('nervous', 49, 100)">Nervous</button>
                <button class="mood-btn btn-yellow" onclick="selectMood('cheerful', 51, 100)">Cheerful</button>
                <button class="mood-btn btn-yellow" onclick="selectMood('ecstatic', 100, 100)">Ecstatic</button>

                <!-- ROW 2 -->
                <button class="mood-btn btn-red" onclick="selectMood('worried', 0, 51)">Worried</button>
                <button class="mood-btn btn-red" onclick="selectMood('angry', 49, 51)">Angry</button>
                <button class="mood-btn btn-yellow" onclick="selectMood('happy', 51, 51)">Happy</button>
                <button class="mood-btn btn-yellow" onclick="selectMood('excited', 100, 51)">Excited</button>

                <!-- ROW 3 -->
                <button class="mood-btn btn-blue" onclick="selectMood('lonely', 0, 49)">Lonely</button>
                <button class="mood-btn btn-blue" onclick="selectMood('sad', 49, 49)">Sad</button>
                <button class="mood-btn btn-green" onclick="selectMood('ease', 51, 49)">At Ease</button>
                <button class="mood-btn btn-green" onclick="selectMood('content', 100, 49)">Content</button>

                <!-- ROW 4 -->
                <button class="mood-btn btn-blue" onclick="selectMood('hopeless', 0, 0)">Hopeless</button>
                <button class="mood-btn btn-blue" onclick="selectMood('disappointed', 49, 0)">Disappointed</button>
                <button class="mood-btn btn-green" onclick="selectMood('calm', 51, 0)">Calm</button>
                <button class="mood-btn btn-green" onclick="selectMood('serene', 100, 0)">Serene</button>
            </div>
        </div>

        <!-- Emre AI Message Box -->
        <div class="ai-message-box" id="aiMessageBox" style="display: none;">
            <div class="ai-icon">💌</div>
            <div class="ai-text" id="aiMessageText">Emre yazıyor...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/mood.js"></script>
}
