@model IEnumerable<emotion_meter.Models.MoodState>
@{
    var gulsah = Model.FirstOrDefault(m => m.UserName == "Gülşah");
}

<div class="planet planet-1"></div>
<div class="planet planet-2"></div>
<div class="stars"></div>

<div class="mobile-app-container">
    
    <!-- Üst Başlık Barı -->
    <div class="header-bar">
        <div class="logo-section">
            <span class="logo-icon">🐙</span>
            <div class="title-text-group">
                <span class="subtitle">GÜLŞAH CUSTOM</span>
                <h2 class="title-text">GÜLŞAH'IN DUYGU METRESİ</h2>
            </div>
        </div>
        <button class="profile-btn">
            👤 Profile
        </button>
    </div>
    
    <!-- Ana Kart -->
    <div class="glass-card">
        <button class="share-btn">
            🔗 Share
        </button>

        <!-- Ahtapot Görsel Alanı -->
        <div class="visual-area" id="visualArea">
            <!-- 5 Ana Resim (Yalnızca Biri Görünecek) -->
            <img src="~/images/happy_octopus.png" id="img-happy" class="octopus-img active-img" />
            <img src="~/images/angry_octopus.png" id="img-angry" class="octopus-img" />
            <img src="~/images/jedi_octopus.png" id="img-jedi" class="octopus-img" />
            <img src="~/images/stressed_octopus.png" id="img-stressed" class="octopus-img" />
            <img src="~/images/zen_octopus.png" id="img-zen" class="octopus-img" />
        </div>

        <!-- Kontroller -->
        <div class="controls-section">
            <div class="slider-group">
                <span class="slider-label">SİNİR <span class="label-icon">👹</span></span>
                <div class="slider-wrapper lightsaber-wrapper saber-red">
                    <input type="range" class="saber-range" id="sinirRange" value="@(gulsah?.Sinir ?? 0)" min="0" max="100" oninput="sendMoodUpdate()">
                </div>
                <span class="slider-value" id="sinirVal">%@(gulsah?.Sinir ?? 0)</span>
            </div>
            
            <div class="slider-group">
                <span class="slider-label">STRES <span class="label-icon">☁️</span></span>
                <div class="slider-wrapper lightsaber-wrapper saber-yellow">
                    <input type="range" class="saber-range" id="stresRange" value="@(gulsah?.Stres ?? 0)" min="0" max="100" oninput="sendMoodUpdate()">
                </div>
                <span class="slider-value" id="stresVal">%@(gulsah?.Stres ?? 0)</span>
            </div>
            
            <div class="slider-group">
                <span class="slider-label">MUTLULUK <span class="label-icon">💜</span></span>
                <div class="slider-wrapper lightsaber-wrapper saber-purple">
                    <input type="range" class="saber-range" id="mutlulukRange" value="@(gulsah?.Mutluluk ?? 100)" min="0" max="100" oninput="sendMoodUpdate()">
                </div>
                <span class="slider-value" id="mutlulukVal">%@(gulsah?.Mutluluk ?? 100)</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/mood.js"></script>
}
